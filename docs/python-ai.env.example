# Place a copy at python-ai/.env
LLM_PROVIDER=openai
LLM_MODEL=replace-with-supported-model
EMBEDDING_MODEL=replace-with-supported-embedding-model
OPENAI_API_KEY=

# Local Qdrant: http://localhost:6333
# Qdrant Cloud: use your cluster URL and API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
UPLOAD_DIR=./data/uploads
TOP_K=4
SIMILARITY_THRESHOLD=
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=10
