# Reference only: prefer the service-specific example files.

# Node backend
PORT=4000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=30000
MAX_UPLOAD_MB=10
UPLOAD_DIR=../../data/uploads

# Python AI service
LLM_PROVIDER=openai
LLM_MODEL=replace-with-supported-model
EMBEDDING_MODEL=replace-with-supported-embedding-model
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
TOP_K=4
SIMILARITY_THRESHOLD=
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Next.js frontend
NODE_API_BASE_URL=http://127.0.0.1:4000
